# Public RPC keys consumed by config/chain_info.ts ⇢ resolveRpcUrls
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_HELIUS_API_KEY=

# Required by RainbowKit / WalletConnect. Without it, the EVM connect button
# falls back to a connector-less wagmi config that cannot open a wallet modal.
# Create one at https://cloud.reown.com (formerly cloud.walletconnect.com).
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional. When set, requests to the Relay API include an Authorization
# header for higher rate limits. See Relay Quickstart "API Key Provisioning".
NEXT_PUBLIC_RELAY_API_KEY=

NEXT_PUBLIC_LOGO_DEV_API_KEY=

# ── Faucet (server-only: NEVER prefix these with NEXT_PUBLIC_) ──
# Hot wallets the faucet pays out from. Keep only modest testnet balances here.
FAUCET_EVM_PRIVATE_KEY=        # 0x-prefixed hex, funded with Base Sepolia ETH
FAUCET_SOLANA_SECRET_KEY=      # base58 (Phantom export) or JSON byte array; holds devnet SOL + tBION
# Optional, for your own reference only (the code doesn't read them).
FAUCET_EVM_WALLET=
FAUCET_SOLANA_WALLET=
# 24h claim cooldown store. Added automatically by Vercel's Upstash integration
# (KV_REST_API_*); a direct Upstash setup uses UPSTASH_REDIS_REST_URL / _TOKEN.
# If missing in local dev, an in-memory store is used instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=