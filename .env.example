# Public RPC keys consumed by config/chain_info.ts ⇢ resolveRpcUrls
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_HELIUS_API_KEY=

# Required by RainbowKit / WalletConnect. Without it, the EVM connect button
# falls back to a connector-less wagmi config that cannot open a wallet modal.
# Create one at https://cloud.reown.com (formerly cloud.walletconnect.com).
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional. When set, requests to the Relay API include an Authorization
# header for higher rate limits. See Relay Quickstart "API Key Provisioning".
NEXT_PUBLIC_RELAY_API_KEY=

NEXT_PUBLIC_LOGO_DEV_API_KEY=